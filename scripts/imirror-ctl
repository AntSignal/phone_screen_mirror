#!/usr/bin/env python3
"""imirror-ctl: read and nudge the running iMirror app from a terminal.

  imirror-ctl status [device] [-n N] [--json]
  imirror-ctl restart <device> [--wait S]
  imirror-ctl events [--device D] [--since 1h] [--json]
  imirror-ctl keyboard pair|forget|test|status <device> [text]
  imirror-ctl keyboard auto on|off|status <device>

It only reads the files the app publishes (devices.json, events.jsonl,
keyboard-pairs.json) and writes restart and keyboard requests, as the
README's "Files other tools read" describes. It never handles a passcode:
`keyboard auto on` only lets the app type the one in its own passcode file.
Standard library only, so it runs on the system python3 (3.9).

Exit codes: 0 ok / accepted, 1 error, 2 usage, 3 cooldown, 4 timeout.
"""

import argparse
import json
import os
import re
import sys
import time
from datetime import datetime, timedelta, timezone

DEFAULT_DEVICES = "~/Library/Application Support/iMirror/devices.json"
RESTART_WAIT_S = 30.0
# App: 120 s pairing window, picked up within 5 s.
KEYBOARD_WAIT_S = {"pair": 130.0, "forget": 30.0, "test": 30.0, "auto_on": 30.0, "auto_off": 30.0}
# The app's rule: lower-case words and digits, with at least one letter
# and at most three digits, so test text is never a passcode attempt.
TEST_TEXT = re.compile(r"(?=.*[a-z])(?!(?:[^0-9]*[0-9]){4})[a-z0-9 ]{1,32}")
# The keyboard event details that answer each request.
KEYBOARD_ANSWERS = {
    "pair": {"paired", "ambiguous", "timeout", "failed"},
    "forget": {"forgotten", "failed"},
    "test": {"typed_test", "failed"},
    "auto_on": {"auto_on", "failed"},
    "auto_off": {"auto_off", "failed"},
}
# An auto on/off request is answered only by its own detail with reason
# "request", or by a failure the request gate or precheck gives. An
# automatic try's own failures (busy, send_failed) answer nothing.
AUTO_REQUEST_FAILURES = {"bad_request", "unknown_action", "bad_text", "stale", "not_attached", "not_paired",
                         "no_file", "no_passcode", "untypeable"}
# What `keyboard auto status` shows: auto-unlock and lock events.
AUTO_DETAILS = {"auto_on", "auto_off", "auto_wake", "auto_typed", "auto_unlocked", "auto_failed", "auto_aborted"}


class CtlError(Exception):
    pass


def devices_file(env=os.environ):
    """IMIRROR_DEVICES_FILE moves every shared file, as in the app and MCP."""
    return env.get("IMIRROR_DEVICES_FILE") or os.path.expanduser(DEFAULT_DEVICES)


def load_registry(path):
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
    except FileNotFoundError:
        raise CtlError(f"no {path}: is iMirror running with Automation on?")
    except (OSError, ValueError) as e:
        raise CtlError(f"can't read {path}: {e}")
    if not isinstance(data, dict) or not isinstance(data.get("devices"), list):
        raise CtlError(f"{path} has no device list")
    return data


def owner_alive(registry):
    pid = registry.get("owner_pid")
    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except PermissionError:
        return True
    except OSError:
        return False
    return True


def _norm(s):
    return s.replace("-", "").lower()


def resolve(query, devices):
    """Same rules as the MCP server's _match: alias, then UDID, then a unique
    UDID prefix, then a unique suffix (4+ characters, dashes ignored). A
    query that fits two phones is refused: both test phones end in 401C."""
    q = query.strip().lower()
    listing = ", ".join(f"{d.get('alias')} ({d.get('udid')})" for d in devices) or "none"
    for d in devices:
        if str(d.get("alias", "")).lower() == q:
            return d
    for d in devices:
        if str(d.get("udid", "")).lower() == q:
            return d
    qn = _norm(q)
    if len(qn) >= 4:
        for how, test in (("prefix", str.startswith), ("suffix", str.endswith)):
            hits = [d for d in devices if d.get("udid") and test(_norm(d["udid"]), qn)]
            if len(hits) == 1:
                return hits[0]
            if hits:
                raise CtlError(f"{query!r} is a UDID {how} of several devices. Devices: {listing}")
    raise CtlError(f"{query!r} matches no device. Devices: {listing}")


def parse_iso(s):
    if not isinstance(s, str):
        return None
    try:
        d = datetime.fromisoformat(s.replace("Z", "+00:00"))
    except ValueError:
        return None
    return d if d.tzinfo else d.replace(tzinfo=timezone.utc)


def iso(d):
    """UTC with milliseconds, as events.jsonl writes it."""
    return d.astimezone(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def parse_since(text, now):
    """'90s', '30m', '1h', '2d', or an ISO-8601 time."""
    m = re.fullmatch(r"\s*(\d+(?:\.\d+)?)\s*([smhd])\s*", text or "")
    if m:
        unit = {"s": 1, "m": 60, "h": 3600, "d": 86400}[m.group(2)]
        return now - timedelta(seconds=float(m.group(1)) * unit)
    d = parse_iso(text)
    if d is None:
        raise CtlError(f"--since {text!r}: use 90s, 30m, 1h, 2d or an ISO-8601 time")
    return d


def read_events(folder, udid=None, since=None):
    """Every events line, oldest first (the rotated .1 file, then the live
    one). Bad lines are skipped: a crash can leave half of one."""
    out = []
    for name in ("events.jsonl.1", "events.jsonl"):
        try:
            with open(os.path.join(folder, name), encoding="utf-8", errors="replace") as f:
                lines = f.readlines()
        except OSError:
            continue
        for raw in lines:
            try:
                e = json.loads(raw)
            except ValueError:
                continue
            if not isinstance(e, dict) or (udid and e.get("udid") != udid):
                continue
            if since is not None:
                ts = parse_iso(e.get("ts"))
                if ts is None or ts < since:
                    continue
            out.append(e)
    return out


def format_event(e):
    what = str(e.get("event", "?"))
    if e.get("from") or e.get("to"):
        what += f" {e.get('from') or '-'} -> {e.get('to') or '-'}"
    for k in ("reason", "detail", "transport"):
        if e.get(k):
            what += f" {k}={e[k]}"
    if isinstance(e.get("chars"), int):
        what += f" chars={e['chars']}"
    if e.get("expected") is True:
        what += " expected"
    return f"{e.get('ts', '?')}  {e.get('alias') or e.get('udid', '?')}  {what}"


def format_device(d, pairs=None):
    rows = [("state", d.get("state")), ("reason", d.get("reason")), ("state_since", d.get("state_since")),
            ("chain_epoch", d.get("chain_epoch")), ("next_retry_at", d.get("next_retry_at")),
            ("last_error", d.get("last_error")), ("detail", d.get("detail")),
            ("keyboard", describe_pair((pairs or {}).get(d.get("udid")))), ("auto_unlock", d.get("auto_unlock"))]
    lines = [f"{d.get('alias')} ({d.get('udid')}, {d.get('kind', 'device')})"]
    lines += [f"  {k:<14}{'-' if v is None else v}" for k, v in rows]
    return "\n".join(lines)


def read_problems(registry):
    """devices.json `problems`: what keeps a phone, or every phone, from
    starting. Older apps write none, so a missing or odd value is no
    problems, and an entry without a string reason and message is skipped."""
    raw = registry.get("problems")
    if not isinstance(raw, list):
        return []
    out = []
    for p in raw:
        if isinstance(p, dict) and isinstance(p.get("reason"), str) and isinstance(p.get("message"), str):
            out.append({k: p[k] for k in ("udid", "reason", "message") if isinstance(p.get(k), str)})
    return out


def format_problem(p):
    # An unslotted phone has no entry or alias: show its UDID.
    return f"problem: {p.get('udid') or 'iMirror'}: {p['message']} ({p['reason']})"


def format_summary(d):
    extra = f" retry at {d['next_retry_at']}" if d.get("next_retry_at") else ""
    return (f"{str(d.get('alias')):<10} {str(d.get('state')):<11} {str(d.get('reason') or '-'):<15}"
            f" since {d.get('state_since') or '-'}  epoch {d.get('chain_epoch', '-')}{extra}")


def write_request(folder, udid, now, by="imirror-ctl", kind="restart", extra=None):
    """Temp file then rename, so the app never reads half a request."""
    if not re.fullmatch(r"[A-Za-z0-9-]{1,64}", udid or ""):
        raise CtlError(f"not a usable UDID: {udid!r}")
    reqs = os.path.join(folder, "requests")
    os.makedirs(reqs, mode=0o700, exist_ok=True)
    path = os.path.join(reqs, f"{kind}-{udid}.json")
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump({"udid": udid, "requested_at": iso(now), "requested_by": by, **(extra or {})}, f)
    os.replace(tmp, path)
    return path


def request_outcome(events, udid, since):
    """The app's answer to a request made at `since`: 'accepted', 'cooldown',
    another detail it logged (stale, not_attached), or None for no answer yet."""
    for e in reversed(events):
        ts = parse_iso(e.get("ts"))
        if e.get("event") == "request" and e.get("udid") == udid and ts is not None and ts >= since:
            return e.get("detail") or None
    return None


def restart(dev, path, wait_s=RESTART_WAIT_S, clock=time.monotonic, sleep=time.sleep, now=None):
    """Ask for a restart, then wait for chain_epoch to move. Returns
    ('accepted' | 'cooldown' | 'timeout' | another app answer, latest entry)."""
    folder = os.path.dirname(path)
    udid = dev["udid"]
    since = now or datetime.now(timezone.utc)
    since = since.replace(microsecond=since.microsecond // 1000 * 1000)   # the app logs ms
    start_epoch = dev.get("chain_epoch")
    req = write_request(folder, udid, since)
    deadline = clock() + wait_s
    latest = dev
    answer = None
    while True:
        answer = request_outcome(read_events(folder, udid, since), udid, since) or answer
        try:
            latest = next((d for d in load_registry(path)["devices"] if d.get("udid") == udid), latest)
        except CtlError:
            pass
        if answer not in (None, "accepted"):
            return answer, latest
        if start_epoch is not None and latest.get("chain_epoch") not in (None, start_epoch):
            return "accepted", latest
        if clock() >= deadline:
            break
        sleep(0.5)
    if answer == "accepted":
        return answer, latest
    try:
        os.unlink(req)   # an old app must not act on it later
    except OSError:
        pass
    return "timeout", latest


EXIT = {"accepted": 0, "cooldown": 3, "timeout": 4}


# ---- keyboard ----

def write_keyboard_request(folder, udid, now, action, text=None):
    if action not in KEYBOARD_ANSWERS:
        raise CtlError(f"unknown keyboard action {action!r}")
    extra = {"action": action}
    if action == "test":
        if not isinstance(text, str) or not TEST_TEXT.fullmatch(text):
            raise CtlError("test text must be 1-32 of a-z, 0-9 and space, with a letter and at most 3 digits")
        extra["text"] = text
    elif text is not None:
        raise CtlError(f"keyboard {action} takes no text")
    return write_request(folder, udid, now, kind="keyboard", extra=extra)


def read_pairs(folder):
    """keyboard-pairs.json as {udid: entry}; {} if absent. An entry has
    "transport" ("dongle": "slot", "peer"; "corebluetooth" or none: "central")."""
    try:
        with open(os.path.join(folder, "keyboard-pairs.json"), encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, ValueError):
        return {}
    return {k: v for k, v in data.items() if isinstance(v, dict)} if isinstance(data, dict) else {}


def answers(e, action):
    """Does keyboard event `e` answer an `action` request?"""
    detail = e.get("detail")
    if detail not in KEYBOARD_ANSWERS[action]:
        return False
    if action in ("auto_on", "auto_off"):
        if detail == "failed":
            return e.get("reason") in AUTO_REQUEST_FAILURES
        return e.get("reason") == "request"
    return True


def keyboard_outcome(events, udid, since, action):
    """The newest keyboard event after `since` that answers `action`, or None."""
    for e in reversed(events):
        ts = parse_iso(e.get("ts"))
        if (e.get("event") == "keyboard" and e.get("udid") == udid and ts is not None and ts >= since
                and answers(e, action)):
            return e
    return None


def keyboard(udid, folder, action, text=None, wait_s=None, clock=time.monotonic, sleep=time.sleep, now=None):
    """Send one keyboard request and wait for its answer. Returns the answering
    event, or None when the app did not answer (the request is withdrawn)."""
    since = now or datetime.now(timezone.utc)
    since = since.replace(microsecond=since.microsecond // 1000 * 1000)   # the app logs ms
    req = write_keyboard_request(folder, udid, since, action, text)
    deadline = clock() + (KEYBOARD_WAIT_S[action] if wait_s is None else wait_s)
    while True:
        answer = keyboard_outcome(read_events(folder, udid, since), udid, since, action)
        if answer is not None:
            return answer
        if clock() >= deadline:
            break
        sleep(0.5)
    try:
        os.unlink(req)   # an old app must not act on it later
    except OSError:
        pass
    return None


KEYBOARD_HINTS = {
    "timeout": "no new phone subscribed in the window. On the phone: Settings > Bluetooth > iMirror Keyboard.",
    "ambiguous": "more than one new Bluetooth central subscribed; turn the others' Bluetooth off and pair again.",
    "not_paired": "pair it first: imirror-ctl keyboard pair <device>",
    "not_connected": "the phone did not connect; is Bluetooth on, and is it still paired?",
    "bluetooth_unavailable": "Bluetooth is off, or iMirror was refused Bluetooth access (System Settings > Privacy).",
    "dongle_unavailable": "this phone is paired with the USB dongle; plug it in (Settings shows 'dongle connected').",
    "dongle_error": "the dongle did not answer in time; unplug it, plug it back in and try again.",
    "no_file": "iMirror can't read its passcode file (Settings > iPhones, the field under the phone list).",
    "no_passcode": "the passcode file has no value for this phone; add <ALIAS>_PASSCODE=... there, then try again.",
    "untypeable": "the passcode in the file has a character the keyboard can't type.",
    "not_attached": "the phone must be on USB to turn auto-unlock on.",
}


def describe_keyboard(alias, answer):
    if answer is None:
        return "timeout: iMirror did not answer; an older build ignores keyboard requests."
    detail, reason = answer.get("detail"), answer.get("reason")
    line = f"{detail}: {alias}" + (f" ({reason})" if reason else "")
    if isinstance(answer.get("chars"), int):
        line += f", {answer['chars']} chars"
    hint = KEYBOARD_HINTS.get(reason or detail)
    return f"{line}\n{hint}" if hint else line


def keyboard_device(query, devices, pairs):
    """A listed phone, or failing that a UDID in keyboard-pairs.json, so a
    phone that has left USB can still be tested or forgotten."""
    try:
        return resolve(query, devices)
    except CtlError:
        hit = next((u for u in pairs if u.lower() == query.strip().lower()), None)
        if hit is None:
            raise
        return {"udid": hit, "alias": hit, "kind": "device"}


def describe_pair(p):
    """One line for a phone's keyboard tie; an old entry has no transport."""
    if not p:
        return "not paired"
    if p.get("transport") == "dongle":
        return f"paired via dongle, slot {p.get('slot')}, peer {p.get('peer')}, at {p.get('paired_at')}"
    return f"paired via this Mac, central {p.get('central')}, at {p.get('paired_at')}"


def format_keyboard_status(dev, pairs, events):
    tie = describe_pair(pairs.get(dev.get("udid")))
    lines = [f"{dev.get('alias')} ({dev.get('udid')})", f"  keyboard      {tie}",
             f"last {len(events)} keyboard events:"]
    lines += ["  " + format_event(e) for e in events] or ["  (none)"]
    return "\n".join(lines)


def main(argv=None):
    p = argparse.ArgumentParser(prog="imirror-ctl", description=__doc__.split("\n\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("status", help="each phone's state, or one phone's state and last events")
    s.add_argument("device", nargs="?")
    s.add_argument("-n", type=int, default=10, help="events to show for one phone (default 10)")
    s.add_argument("--json", action="store_true")
    r = sub.add_parser("restart", help="ask iMirror to restart a phone's WDA chain")
    r.add_argument("device")
    r.add_argument("--wait", type=float, default=RESTART_WAIT_S, help="seconds to wait (default 30)")
    e = sub.add_parser("events", help="print events.jsonl lines")
    e.add_argument("--device")
    e.add_argument("--since", help="90s, 30m, 1h, 2d or ISO-8601")
    e.add_argument("--json", action="store_true")
    k = sub.add_parser("keyboard", help="pair, test or forget iMirror's Bluetooth keyboard for a phone")
    k.add_argument("action", choices=["pair", "forget", "test", "status", "auto"])
    k.add_argument("device", help="the phone; for auto: on, off or status, then the phone")
    k.add_argument("text", nargs="?", help="test only: a-z, 0-9 and space; a letter, at most 3 digits")
    k.add_argument("--wait", type=float, help="seconds to wait (default 130 for pair, else 30)")
    k.add_argument("-n", type=int, default=10, help="status: keyboard events to show (default 10)")
    a = p.parse_args(argv)

    path = devices_file()
    folder = os.path.dirname(path)
    try:
        if a.cmd == "events":
            udid = resolve(a.device, load_registry(path)["devices"])["udid"] if a.device else None
            since = parse_since(a.since, datetime.now(timezone.utc)) if a.since else None
            for ev in read_events(folder, udid, since):
                print(json.dumps(ev, sort_keys=True) if a.json else format_event(ev))
            return 0
        reg = load_registry(path)
        if not owner_alive(reg):
            print(f"warning: iMirror (pid {reg.get('owner_pid')}) is not running; {path} is stale",
                  file=sys.stderr)
            if a.cmd == "restart" or (a.cmd == "keyboard" and not is_status(a)):
                return 1
        devices = reg["devices"]
        if a.cmd == "keyboard":
            return keyboard_main(a, devices, folder)
        if a.cmd == "status":
            problems = read_problems(reg)
            if not a.device:
                # --json stays a bare device list, as scripts expect.
                print(json.dumps(devices, indent=2) if a.json
                      else "\n".join(list(map(format_summary, devices)) + list(map(format_problem, problems))))
                return 0
            d = resolve(a.device, devices)
            problems = [p for p in problems if p.get("udid") in (None, d.get("udid"))]
            evs = read_events(folder, d.get("udid"))[-max(a.n, 0):] if a.n > 0 else []
            if a.json:
                kb = read_pairs(folder).get(d.get("udid"))
                print(json.dumps({"device": d, "events": evs, "keyboard": kb, "problems": problems}, indent=2))
            else:
                print("\n".join([format_device(d, read_pairs(folder))] + list(map(format_problem, problems))))
                print(f"last {len(evs)} events:")
                print("\n".join("  " + format_event(ev) for ev in evs) or "  (none)")
            return 0
        d = resolve(a.device, devices)
        if d.get("kind") == "simulator":
            raise CtlError(f"{d.get('alias')} is a Simulator; requests only restart phones")
        result, latest = restart(d, path, wait_s=a.wait)
        print(f"{result}: {latest.get('alias')} is {latest.get('state')}"
              f" (reason {latest.get('reason') or '-'}, epoch {latest.get('chain_epoch', '-')})")
        if result == "cooldown":
            print("a restart ran in the last minute; wait for it instead of asking again")
        elif result == "timeout":
            print("iMirror did not answer; an older build ignores requests. Tap the phone's WDA status.")
        return EXIT.get(result, 1)
    except CtlError as err:
        print(f"imirror-ctl: {err}", file=sys.stderr)
        return 1


def is_status(a):
    return a.action == "status" or (a.action == "auto" and a.device == "status")


def format_auto_status(dev, events):
    lines = [f"{dev.get('alias')} ({dev.get('udid')})", f"  auto_unlock   {dev.get('auto_unlock') or '-'}",
             f"  reason        {dev.get('reason') or '-'}", f"last {len(events)} auto-unlock and lock events:"]
    lines += ["  " + format_event(e) for e in events] or ["  (none)"]
    return "\n".join(lines)


def auto_main(a, devices, folder):
    """keyboard auto on|off|status <device>. Takes no passcode: the app
    types the one in its own passcode file, and only when it finds the
    phone locked."""
    if a.device not in ("on", "off", "status") or not a.text:
        raise CtlError("usage: imirror-ctl keyboard auto on|off|status <device>")
    pairs = read_pairs(folder)
    d = keyboard_device(a.text, devices, pairs)
    if d.get("kind") == "simulator":
        raise CtlError(f"{d.get('alias')} is a Simulator; auto-unlock is for phones")
    if a.device == "status":
        evs = [e for e in read_events(folder, d["udid"])
               if e.get("event") == "lock" or (e.get("event") == "keyboard" and e.get("detail") in AUTO_DETAILS)]
        print(format_auto_status(d, evs[-max(a.n, 0):] if a.n > 0 else []))
        return 0
    action = "auto_" + a.device
    answer = keyboard(d["udid"], folder, action, wait_s=a.wait)
    print(describe_keyboard(d.get("alias"), answer))
    if answer is None:
        return 4
    return 0 if answer.get("detail") == action else 1


def keyboard_main(a, devices, folder):
    if a.action == "auto":
        return auto_main(a, devices, folder)
    pairs = read_pairs(folder)
    d = keyboard_device(a.device, devices, pairs)
    if d.get("kind") == "simulator":
        raise CtlError(f"{d.get('alias')} is a Simulator; the keyboard is for phones")
    if a.action == "status":
        evs = [e for e in read_events(folder, d["udid"]) if e.get("event") == "keyboard"]
        print(format_keyboard_status(d, pairs, evs[-max(a.n, 0):] if a.n > 0 else []))
        return 0
    if a.action == "pair":
        print(f"On {d.get('alias')}: Settings > Bluetooth, tap 'iMirror Keyboard' within 120 s.", flush=True)
    answer = keyboard(d["udid"], folder, a.action, a.text, wait_s=a.wait)
    print(describe_keyboard(d.get("alias"), answer))
    if answer is None:
        return 4
    return 0 if answer.get("detail") in ("paired", "forgotten", "typed_test") else 1


if __name__ == "__main__":
    sys.exit(main())
